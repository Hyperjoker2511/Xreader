<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required beside the dataSync foreground-service type
         at targetSdk 34+ (the update download's service). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- In-app updater: the system answers
         PackageManager.canRequestPackageInstalls() with a
         SecurityException when this permission is not declared,
         which crashed the Install tap (v1.5.42 hotfix). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Labs eye-tracking only (Phase 4): requested at runtime solely
         when the user enables the experiment. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <application
        android:name=".XreaderApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Xreader">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FIX-18: the transplanted Komikku manga reader. Its own
             Activity at the settled boundary (donor ReaderActivity
             kept): manga books open here through its newIntent
             contract; novels never leave MainActivity's reader. -->
        <activity
            android:name="app.xreader.komikku.KomikkuReaderActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.Xreader" />

        <!-- v1.5.42: the update download's foreground shell —
             keeps the process alive while UpdateDownloadManager
             downloads in the background; dataSync type. -->
        <service
            android:name=".data.update.UpdateDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Quote-card sharing (Phase 6): hands the rendered PNG to
             the share sheet; exposes only the quote-cards cache dir. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="app.xreader.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Home-screen widget (Phase 6, Glance). -->
        <receiver
            android:name=".widget.XreaderWidgetReceiver"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/xreader_widget_info" />
        </receiver>
    </application>
</manifest>
