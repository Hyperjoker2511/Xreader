<?xml version="1.0" encoding="utf-8"?>
<!-- K6 smoke fixture A: a single HttpSource + ConfigurableSource
     (Asura's shape). versionName carries the lib-1.6 marker the
     same way real Keiyoushi packages do (1.6.x). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="eu.kanade.tachiyomi.extension.en.fixturepanels"
    android:versionCode="1"
    android:versionName="1.6.1">

    <uses-feature android:name="tachiyomi.extension" android:required="true" />

    <application android:label="Fixture Panels">
        <meta-data
            android:name="tachiyomi.extension.class"
            android:value="fixture.panels.FixturePanelsSource" />
        <meta-data
            android:name="tachiyomix.name"
            android:value="Fixture Panels" />
        <meta-data
            android:name="tachiyomix.extensionLib"
            android:value="1.6" />
        <meta-data
            android:name="tachiyomix.contentWarning"
            android:value="0" />
    </application>
</manifest>
